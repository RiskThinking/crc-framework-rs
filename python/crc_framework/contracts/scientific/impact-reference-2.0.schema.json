{
  "$id": "https://climateriskcommons.org/schemas/impact-reference-2.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "enum": [
        "crc:freeze_thaw_cycles",
        "crc:frost_days",
        "crc:maximum_daily_precipitation",
        "crc:cyclone",
        "crc:maximum_daily_wind_speed",
        "crc:fire_weather_index",
        "crc:hot_days",
        "crc:coastal_flood",
        "crc:river_flood",
        "crc:inundation",
        "crc:standardized_precipitation_evapotranspiration_index",
        "crc:cooling_degree_days",
        "crc:cooling_degree_days_crop_yield",
        "crc:consecutive_dry_days"
      ]
    },
    "manifest_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0"
    },
    "version": {
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "manifest_sha256"
  ],
  "title": "ImpactReference",
  "type": "object"
}
